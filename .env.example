# DadaFX — copy to .env.local for local overrides. NEVER commit real secrets.
# .env / .env.local are git-ignored. The published key below is public by
# design (RLS enforces everything); service-role and master keys live ONLY
# as Supabase function secrets — never here, never in the browser.

# Supabase project (public identifiers — safe to share)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# --- Server-side ONLY (supabase secrets set — NEVER VITE_*, NEVER committed) ---
# BROKER_MASTER_KEY=<openssl rand -hex 32>          # AES-GCM for user broker tokens
# CRON_SECRET=<openssl rand -hex 24>                # pg_cron sweep bearer
# CTRADER_CLIENT_ID=<spotware open-api app id>      # OAuth app identity
# CTRADER_CLIENT_SECRET=<spotware open-api secret>  # OAuth exchange, server only
# APP_URL=https://your-app.vercel.app               # OAuth final redirect
# NOTE: OANDA has no OAuth app model — users paste personal tokens in-app,
# which are encrypted server-side. There is no OANDA_CLIENT_ID/SECRET.
